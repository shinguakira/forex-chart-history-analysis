{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forex Chart Analysis",
  "version": "0.1.0",
  "identifier": "com.forex.chart-analysis",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../../frontend dev"
  },
  "app": {
    "windows": [
      {
        "title": "Forex Chart Analysis",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../../target/release/WebView2Loader.dll"
    ],
    "shortDescription": "Forex chart history & AI analysis",
    "longDescription": "Personal forex chart analysis app: Yahoo Finance candles, trade history, predictions, backtests, and AI-assisted review (Claude / Ollama).",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English", "Japanese"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  }
}
