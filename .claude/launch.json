{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 2173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--bin", "forex-server", "--features", "sqlite"],
      "port": 24000,
      "url": "http://localhost:24000"
    }
  ]
}
